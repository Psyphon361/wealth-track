{
  "name": "wealth-track",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd api && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm --prefix web run dev",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
