{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "git": { "deploymentEnabled": { "main": false } },
  "crons": [
    { "path": "/api/cron/amfi", "schedule": "30 16 * * *" },
    { "path": "/api/cron/securities", "schedule": "0 14 * * *" }
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{.venv/**,alembic/**,alembic.ini,.env,.env.example,README.md,tests/**,requirements-dev.txt,pyproject.toml,.pytest_cache/**,**/__pycache__/**}"
    }
  }
}
