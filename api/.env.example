DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
CORS_ORIGINS=["http://localhost:3000"]
# Shared secret the web app sends as X-API-Key. Leave empty locally (no check).
API_KEY=
# Bearer secret for the Vercel cron route GET /api/cron/amfi. Unset = the route always returns 401.
CRON_SECRET=
# Signs access tokens (HS256). Generate with: openssl rand -hex 32. Required for sign-in.
JWT_SECRET=
# Comma-separated emails allowed to sign up (invite list). Empty = nobody can sign up.
ALLOWED_EMAILS=
# Owner of holdings that existed before auth; used by migration 0010 (OWNER_EMAIL env wins over this).
OWNER_EMAIL=
