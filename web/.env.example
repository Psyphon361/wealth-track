# Server-only variables (never prefix with NEXT_PUBLIC_).
# Password gate. Empty = gate disabled in development; in production an empty value fails closed.
APP_PASSWORD=
# Secret for signing session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# FastAPI origin used by the /api proxy.
API_URL=http://localhost:8000
# Optional: sent as X-API-Key to FastAPI.
API_KEY=
