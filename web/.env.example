# Server-only variables (never prefix with NEXT_PUBLIC_).
# FastAPI origin used by the /api proxy and auth server actions.
API_URL=http://localhost:8000
# Optional: sent as X-API-Key to FastAPI.
API_KEY=
# Google sign-in (OAuth client ID of type "Web application"; no secret needed, PKCE is used).
# Authorised redirect URI: <app origin>/auth/google/callback
GOOGLE_CLIENT_ID=
# Optional: public origin of the web app used to build the redirect URI (e.g. https://app.example.com).
# Defaults to the request's origin.
APP_ORIGIN=
